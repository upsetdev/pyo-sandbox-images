# The desktop's dock: a bar centered at the bottom with launchers for
# the terminal, the browser and the file manager, the open windows as
# icons, and a clock. voxl rounds its corners (--round-windows in
# desktop.py), so it needs no compositor.

disable_transparency = 1

# Backgrounds: 1 the dock, 2 an open window, 3 the active one,
# 4 tooltips.
rounded = 18
border_width = 1
background_color = #17181d 100
border_color = #ffffff 12

rounded = 10
border_width = 0
background_color = #ffffff 0
border_color = #000000 0
background_color_hover = #ffffff 8
background_color_pressed = #ffffff 14

rounded = 10
border_width = 0
background_color = #ffffff 14
border_color = #000000 0
background_color_hover = #ffffff 18
background_color_pressed = #ffffff 22

rounded = 8
border_width = 1
background_color = #1f2026 100
border_color = #ffffff 12

panel_items = L:TSC
panel_size = 100% 62
panel_shrink = 1
panel_margin = 0 10
panel_padding = 10 7 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
panel_dock = 0
strut_policy = follow_size
mouse_effects = 1
mouse_hover_icon_asb = 100 0 12
mouse_pressed_icon_asb = 100 0 -8

launcher_padding = 0 0 6
launcher_background_id = 0
launcher_icon_background_id = 2
launcher_icon_size = 40
launcher_icon_theme = Pyo
launcher_icon_theme_override = 1
launcher_tooltip = 1
launcher_item_app = /usr/local/share/pyo-desktop/dock/terminal.desktop
launcher_item_app = /usr/share/applications/browser.desktop
launcher_item_app = /usr/local/share/pyo-desktop/dock/files.desktop

separator = new
separator_background_id = 0
separator_color = #ffffff 16
separator_style = line
separator_size = 1
separator_padding = 6 10

taskbar_mode = single_desktop
taskbar_hide_if_empty = 1
taskbar_padding = 0 0 6
taskbar_background_id = 0
taskbar_name = 0
task_icon = 1
task_text = 0
task_centered = 1
task_maximum_size = 48 48
task_padding = 4 4 0
task_tooltip = 1
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 3
task_iconified_background_id = 2
task_iconified_icon_asb = 100 -20 -25

systray_padding = 4 0 6
systray_background_id = 0
systray_icon_size = 20
systray_sort = ascending

time1_format = %H:%M
time1_font = Inter Variable Semi-Bold 10
time2_format = %a %-d %b
time2_font = Inter Variable 8
clock_font_color = #e8e9ed 100
clock_padding = 10 0
clock_background_id = 0
clock_tooltip = %A, %-d %B %Y

tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1
tooltip_padding = 8 5
tooltip_background_id = 4
tooltip_font = Inter Variable 9
tooltip_font_color = #e8e9ed 100

mouse_left = toggle_iconify
mouse_middle = close
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none
