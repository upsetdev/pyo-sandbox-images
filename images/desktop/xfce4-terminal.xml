<?xml version="1.0" encoding="UTF-8"?>
<!-- The terminal's defaults: JetBrains Mono, Pyo's colors, no menu bar
     or scroll bar, and a cursor that doesn't blink (a blinking cursor
     keeps the screen's stream busy). -->
<channel name="xfce4-terminal" version="1.0">
  <property name="font-use-system" type="bool" value="false"/>
  <property name="font-name" type="string" value="JetBrains Mono 11"/>
  <property name="misc-menubar-default" type="bool" value="false"/>
  <property name="misc-toolbar-default" type="bool" value="false"/>
  <property name="misc-borders-default" type="bool" value="true"/>
  <property name="misc-default-geometry" type="string" value="96x26"/>
  <property name="misc-cursor-shape" type="string" value="TERMINAL_CURSOR_SHAPE_IBEAM"/>
  <property name="misc-cursor-blinks" type="bool" value="false"/>
  <property name="misc-confirm-close" type="bool" value="false"/>
  <property name="misc-show-unsafe-paste-dialog" type="bool" value="false"/>
  <property name="misc-slim-tabs" type="bool" value="true"/>
  <property name="scrolling-bar" type="string" value="TERMINAL_SCROLLBAR_NONE"/>
  <property name="scrolling-unlimited" type="bool" value="true"/>
  <property name="color-use-theme" type="bool" value="false"/>
  <property name="color-foreground" type="string" value="#e4e5e9"/>
  <property name="color-background" type="string" value="#121317"/>
  <property name="color-cursor-use-default" type="bool" value="false"/>
  <property name="color-cursor" type="string" value="#7aa2ff"/>
  <property name="color-cursor-foreground" type="string" value="#121317"/>
  <property name="color-selection-use-default" type="bool" value="false"/>
  <property name="color-selection" type="string" value="#ffffff"/>
  <property name="color-selection-background" type="string" value="#2c4a94"/>
  <property name="color-bold-use-default" type="bool" value="true"/>
  <property name="color-bold-is-bright" type="bool" value="false"/>
  <property name="color-palette" type="string" value="#2a2c33;#f26d6d;#4cd28a;#f2c66d;#6b95ff;#b493ff;#4ccfe0;#c9ccd4;#5c606b;#ff8f8f;#72e6a6;#ffd88a;#94b3ff;#cbb3ff;#7adff0;#ffffff"/>
</channel>
