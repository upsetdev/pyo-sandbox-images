# Openbox theme "Pyo": flat, dark title bars in Pyo's grays, the title
# centered in Inter, and small plain buttons. voxl rounds the windows'
# corners (--round-corners in desktop.py).

border.width: 1
padding.width: 10
padding.height: 7
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap: 0
menu.border.width: 1
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4

window.active.border.color: #2e3038
window.inactive.border.color: #24262c
window.active.client.color: #1b1c21
window.inactive.client.color: #1b1c21
menu.border.color: #2e3038

window.active.title.bg: flat solid
window.active.title.bg.color: #1f2026
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #17181c
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #ececec
window.inactive.label.text.color: #7d808a
window.label.text.justify: center

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #b9bcc6
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #33353d
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #43464f
window.active.button.pressed.image.color: #ffffff
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #b9bcc6
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #33353d
window.active.button.toggled.hover.image.color: #ffffff
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #43464f
window.active.button.toggled.pressed.image.color: #ffffff
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #4a4d56

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #5c5f69
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #2a2c33
window.inactive.button.hover.image.color: #d0d2d8
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #3a3c44
window.inactive.button.pressed.image.color: #ffffff
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #5c5f69
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #3a3c44

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1f2026
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #17181c
window.active.grip.bg: flat solid
window.active.grip.bg.color: #1f2026
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #17181c

menu.title.bg: flat solid
menu.title.bg.color: #1f2026
menu.title.text.color: #8b8e98
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #1f2026
menu.items.text.color: #e4e5e9
menu.items.disabled.text.color: #5c5f69
menu.items.active.bg: flat solid
menu.items.active.bg.color: #2465ff
menu.items.active.text.color: #ffffff
menu.items.active.disabled.text.color: #9fb6ff
menu.separator.color: #2e3038

osd.border.width: 1
osd.border.color: #2e3038
osd.bg: flat solid
osd.bg.color: #1f2026
osd.label.bg: parentrelative
osd.label.text.color: #e4e5e9
osd.hilight.bg: flat solid
osd.hilight.bg.color: #2465ff
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #33353d
